{
  "name": "so-ready",
  "version": "1.0.0",
  "private": true,
  "description": "SO Ready - offline pricing and quotation calculator",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.visi0n.soready",
    "productName": "SO Ready",
    "files": ["main.js", "index.html"],
    "directories": { "output": "dist" },
    "win": { "target": ["portable"] },
    "portable": { "artifactName": "SO-Ready-Portable-${version}.exe" }
  }
}
